{
  "name": "night-neutralizer",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that reduces audio and video dynamic range for comfortable night-time viewing.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "clean": "node scripts/build.mjs --clean-only",
    "build": "node scripts/build.mjs && npm run sync:root",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "testpage": "node scripts/serve-test-page.mjs",
    "smoke": "node scripts/smoke.mjs",
    "zip": "node scripts/build.mjs --zip && npm run sync:root",
    "sync:root": "node scripts/sync-root.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/node": "24.3.0",
    "esbuild": "0.28.1",
    "jsdom": "30.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
