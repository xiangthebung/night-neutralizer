{
  "manifest_version": 3,
  "name": "Night Neutralizer",
  "version": "1.0.0",
  "description": "Softens harsh video and audio for night-time viewing: adaptive tone mapping plus audio dynamic-range compression. 100% local.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Turn Night Neutralizer on or off"
    }
  },
  "action": {
    "default_title": "Night Neutralizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
